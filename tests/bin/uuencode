#!/usr/bin/env python3
"""Minimal BusyBox-style `uuencode -m [FILE] NAME` for the synthetic test board."""

import base64
import sys

args = [a for a in sys.argv[1:] if a != "-m"]
data = open(args[0], "rb").read() if len(args) == 2 else sys.stdin.buffer.read()
print(f"begin-base64 644 {args[-1]}")
for i in range(0, len(data), 45):
    print(base64.b64encode(data[i : i + 45]).decode())
print("====")
